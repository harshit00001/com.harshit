# Copy to .env (do not commit .env). Set these in User/Project env or Cursor MCP env block.
INTERNAL_MCP_BASE_URL=http://indmzossger/admin/repos
INTERNAL_MCP_USERNAME=your_username
INTERNAL_MCP_PASSWORD=your_password
# Optional: set to false only if your internal server uses a self-signed cert (not recommended).
INTERNAL_MCP_VERIFY_SSL=true
# Optional: default Accept header (e.g. application/json if the server returns JSON).
INTERNAL_MCP_ACCEPT=text/html,application/json;q=0.9,*/*;q=0.1
